{
  "name": "english90",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "prebuild": "npm run validate:content",
    "analyze": "npm run analyze:stats && npm run analyze:leaks && npm run validate:analysis",
    "analyze:stats": "cd scripts/analysis && uv run python analyze_corpus.py",
    "analyze:leaks": "cd scripts/analysis && uv run python check_leaks.py",
    "validate:analysis": "tsx scripts/validate-analysis.ts",
    "tag:items": "tsx scripts/tag-items.ts",
    "tag:review": "tsx scripts/tag-review.ts",
    "analyze:tags": "tsx scripts/tag-stats.ts && npm run analyze:leaks && npm run validate:analysis",
    "blueprints:draft": "tsx scripts/blueprint-drafts.ts && npm run validate:content",
    "vocab:import": "tsx scripts/import-vocab.ts",
    "vocab:approve": "tsx scripts/approve-vocab.ts",
    "content:generate": "tsx scripts/content-pipeline/generate.ts",
    "content:crosscheck": "tsx scripts/content-pipeline/crosscheck.ts",
    "content:revise": "tsx scripts/content-pipeline/revise.ts",
    "content:reports": "tsx scripts/content-pipeline/reports.ts",
    "postbuild": "tsx scripts/check-trace.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.23.0",
    "ts-fsrs": "6.0.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
